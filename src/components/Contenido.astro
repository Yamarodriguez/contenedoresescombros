---
// Contenido de la página con su maquetación original de Elementor: cada fila
// principal es una banda (fondo alterno) y dentro van sus columnas. El orden y
// el contenido no cambian. Si una página no tuviera filas, se pinta en lista.
import Bloque from './Bloque.astro';
import Fila from './Fila.astro';

interface Props { bloques: any[]; filas?: any[]; omitir?: number[] }
const { bloques, filas = [], omitir = [] } = Astro.props as Props;
const salta = new Set(omitir);
const visibles = (f: any): number => f.columnas.reduce((n: number, c: any) => n + c.items.reduce((m: number, it: any) => m + (it.fila ? visibles(it.fila) : salta.has(it.b) ? 0 : 1), 0), 0);
const bandas = filas.filter((f) => visibles(f) > 0);
---
<div class="contenido">
  {bandas.length
    ? bandas.map((f) => (
        <section class="banda">
          <div class="banda-in">
            <Fila fila={f} bloques={bloques} omitir={omitir} />
          </div>
        </section>
      ))
    : (
        <section class="banda">
          <div class="banda-in">
            {bloques.map((b, i) => !salta.has(i) && <Bloque b={b} />)}
          </div>
        </section>
      )}
</div>
