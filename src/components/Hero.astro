---
import imagenes from '../data/imagenes.json';

// Sin botones en la cabecera (Yama, 2026-11-03): el WhatsApp flotante sigue en todas las páginas.
interface Props { titulo: string; subtitulo?: string; cta?: boolean; imagen?: { src: string; alt: string } | null }
const { titulo, subtitulo, imagen = null } = Astro.props;
// Imagen principal de la página (palabra clave en el fichero y en el alt). Arriba del
// todo: carga en el momento, no en diferido.
const d = imagen ? (imagenes as Record<string, any>)[imagen.src] || {} : {};
const base = imagen ? imagen.src.replace(/\.(jpe?g|png)$/i, '') : '';
const srcset = ((d.ws || []) as number[]).map((w) => `${base}-${w}.webp ${w}w`).join(', ');
---
<section class="heroe">
  <div class:list={['heroe-in', { 'con-imagen': imagen }]}>
    <div class="heroe-texto">
      <h1>{titulo}</h1>
      {subtitulo && <p class="heroe-sub">{subtitulo}</p>}
      <slot />
    </div>
    {imagen && (
      <div class="heroe-imagen">
        <picture>
          {srcset && <source type="image/webp" srcset={srcset} sizes="(max-width: 860px) 100vw, 520px" />}
          <img src={imagen.src} alt={imagen.alt} width={d.w} height={d.h} fetchpriority="high" decoding="async" />
        </picture>
      </div>
    )}
  </div>
</section>
