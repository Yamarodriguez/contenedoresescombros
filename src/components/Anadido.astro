---
// Contenido nuevo que va ENCIMA del original (src/data/contenido-nuevo.json), p. ej.
// la página de Excavaciones (Yama, 2026-11-03). Usa los mismos bloques y estilos.
import Bloque from './Bloque.astro';
import ciudades from '../data/ciudades.json';
import datosExcavacion from '../data/excavaciones-ciudades.json';
import { gruposExcavacion } from '../lib/excavaciones.mjs';

interface Props { datos: any }
const { datos } = Astro.props as Props;
const h2 = (text: string) => ({ type: 'heading', tag: 'h2', text });
const texto = (html: string) => ({ type: 'text', html, text: '' });
// Filas completas: de 4 en 4 si salen justas; si no, como mucho 3 por fila (6 -> 3+3, 5 -> 3+2).
const rejilla = (n: number) => (n % 4 === 0 ? 'tarjetas-texto' : 'tarjetas-texto tres');
// Sección con «enlacesExcavaciones»: las páginas de excavaciones por comunidad y provincia,
// con las localidades de cada provincia debajo (Yama, 2026-11-03).
const gruposCiudad = gruposExcavacion(datosExcavacion, ciudades);
---
<div class="contenido anadido">
  {datos.entradilla && (
    <section class="banda">
      <div class="banda-in"><div class="texto entradilla" set:html={datos.entradilla} /></div>
    </section>
  )}
  {datos.secciones.map((s: any) => (
    <section class="banda">
      <div class="banda-in">
        {s.foto ? (
          <div class="fila cols-2" style="--plantilla:1.15fr .85fr">
            <div class="col">
              <Bloque b={h2(s.h2)} />
              {s.html && <Bloque b={texto(s.html)} />}
            </div>
            <div class="col"><Bloque b={{ type: 'image', src: `/img/nuevas/${s.foto.nombre}.jpg`, alt: s.h2 }} /></div>
          </div>
        ) : (
          <>
            <Bloque b={h2(s.h2)} />
            {s.enlacesExcavaciones && (
              <div class="grupos-excavacion">
                {gruposCiudad.map((g: any) => (
                  <div class="grupo-excavacion">
                    <h3 class="titular">{g.comunidad}</h3>
                    <ul class="enlaces-zona">
                      {g.provincias.map((p: any) => <li><a href={p.ruta}>{p.clave}</a></li>)}
                    </ul>
                    {g.provincias.filter((p: any) => p.localidades.length).map((p: any) => (
                      <div class="localidades">
                        <p class="texto">Localidades de {p.nombre}:</p>
                        <ul class="enlaces-zona">
                          {p.localidades.map((l: any) => <li><a href={l.ruta}>{l.clave}</a></li>)}
                        </ul>
                      </div>
                    ))}
                  </div>
                ))}
              </div>
            )}
            {s.html && <Bloque b={texto(s.html)} />}
          </>
        )}
        {s.tarjetas && (
          <div class={rejilla(s.tarjetas.length)}>
            {s.tarjetas.map((t: any) => (
              <article class="tarjeta-texto"><h3 class="titular">{t.h3}</h3><div class="texto" set:html={t.html} /></article>
            ))}
          </div>
        )}
        {s.faq && (
          <div class={rejilla(s.faq.length)}>
            {s.faq.map((f: any) => (
              <article class="tarjeta-texto"><h3 class="titular">{f.pregunta}</h3><div class="texto"><p>{f.respuesta}</p></div></article>
            ))}
          </div>
        )}
        {s.boton && <p><a class="boton" href={s.boton.href}>{s.boton.texto}</a></p>}
      </div>
    </section>
  ))}
</div>
