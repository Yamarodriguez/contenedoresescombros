---
// Logo «Contenedores / ESCOMBROS», al estilo del de Contenedores Marítimos (Yama, 2026-11-03):
// globo verde con la cuba amarilla de escombros y la órbita, y el nombre en dos líneas
// separadas por la raya amarilla.
interface Props { claro?: boolean; tam?: number }
const { claro = false, tam = 52 } = Astro.props;
---
<span class:list={['logo-marca', { 'logo-claro': claro }]}>
  <img src="/img/logo-contenedores.svg" alt="" width={tam} height={tam} />
  <span class="marca"><b>Contenedores</b><i>Escombros</i></span>
</span>
