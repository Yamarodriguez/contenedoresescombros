---
// Seccion anadida al final de cada pagina de ciudad: provincia y localidades
// cercanas enlazadas (datos geograficos de OpenStreetMap). Texto factual.
// excavacion: ruta de la página de excavaciones de esa ciudad, si la hay.
const { zona, excavacion = null } = Astro.props as { zona: any; excavacion?: string | null };
---
{zona && (
  <section class="seccion">
    <div class="seccion-in">
      <h2 class="titular">Contenedores de escombros cerca de {zona.nombre}</h2>
      {zona.provincia && (
        <p class="texto">{zona.nombre} pertenece a la provincia de {zona.provincia}.{zona.provinciaSlug && (<> Consulta todos los <a href={`/${zona.provinciaSlug}/`}>contenedores de escombros en {zona.provincia}</a>.</>)}</p>
      )}
      {zona.cercanas && zona.cercanas.length > 0 && (
        <>
          <p class="texto">Estas son otras localidades cercanas donde también encontrarás contenedores de escombros:</p>
          <ul class="enlaces-zona">
            {zona.cercanas.map((c: any) => <li><a href={`/${c.slug}/`}>Contenedores de escombros en {c.nombre}</a></li>)}
          </ul>
        </>
      )}
      {excavacion && (
        <p class="texto">¿Vas a hacer una excavación? Consulta las <a href={excavacion}>excavaciones y movimiento de tierras en {zona.nombre}</a>.</p>
      )}
    </div>
  </section>
)}
