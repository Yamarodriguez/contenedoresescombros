---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Contenido from '../components/Contenido.astro';
import Faq from '../components/Faq.astro';
import Zona from '../components/Zona.astro';
import { seoDe } from '../lib/seo';
import site from '../data/site.json';
import faqData from '../data/faq.json';
import ciudades from '../data/ciudades.json';
import cambiosData from '../data/fallos-original.json';
import principales from '../data/principales.json';
import contenidoNuevo from '../data/contenido-nuevo.json';
import Anadido from '../components/Anadido.astro';
import datosExcavacion from '../data/excavaciones-ciudades.json';
import { rutaExcavacion } from '../lib/excavaciones.mjs';
import { aplicarCambios, tipoFrase, nombresPropios, detectarFaq, bloquesDeFila } from '../lib/textos.mjs';

export async function getStaticPaths() {
  const files = import.meta.glob('../content/pages/*.json', { eager: true });
  return Object.values(files)
    .map((m: any) => m.default)
    .filter((d: any) => d.slug !== 'index')
    .map((d: any) => ({
      params: { slug: new URL(d.url).pathname.replace(/^\/|\/$/g, '') },
      props: { data: d },
    }));
}

const { data } = Astro.props as { data: any };
const dominio = `https://${site.dominio}`;
const key = new URL(data.url).pathname.replace(/^\/|\/$/g, '').replace(/\//g, '__') || 'index';
const seo = seoDe(key);
// Cambios aprobados por Yama (títulos, H1, descripciones, mayúsculas y alt): src/data/fallos-original.json
const cambios = cambiosData as any;
const propios = nombresPropios(ciudades);
const h1 = data.blocks.find((b: any) => b.type === 'heading' && b.tag === 'h1');
const tituloH1 = cambios.h1[data.slug] || tipoFrase(h1 ? h1.text : data.title, propios);
const bloques = aplicarCambios(data.blocks, { titulo: tituloH1, propios });
// Partes del original que Yama ha pedido quitar (fallos-original.json -> quitar).
const quitados = new Set<number>(cambios.quitar?.[data.slug] || []);
const filas = (data.filas || []).filter((f: any) => !bloquesDeFila(f).every((i: number) => quitados.has(i)));
const omitir = [...data.blocks.map((b: any, i: number) => (b.type === 'heading' && b.tag === 'h1' ? i : -1)).filter((i: number) => i >= 0), ...quitados];
const migas = [{ nombre: 'Inicio', url: `${dominio}/` }, { nombre: cambios.h1[data.slug] || tipoFrase(data.title, propios), url: data.url }];
const faq = (faqData as Record<string, any[]>)[data.slug] || [];
// Bloque Medidas / Recogida convertido en preguntas: si existe, las preguntas de faq.json van dentro.
const faqBloque = filas.map((f: any) => detectarFaq(f, bloques, cambios.preguntas)).find(Boolean);
// Contenido nuevo encima del original (p. ej. Excavaciones): sus preguntas también van a los datos.
const anadido = (contenidoNuevo as Record<string, any>)[data.slug] || null;
const preguntasPagina = [
  ...(anadido ? anadido.secciones.flatMap((s: any) => s.faq || []) : []),
  ...(faqBloque ? faqBloque.items.map((it: any) => ({ pregunta: it.q, respuesta: bloques[it.t].text })) : []),
  ...faq,
];
const datos = preguntasPagina.length ? [{ '@type': 'FAQPage', mainEntity: preguntasPagina.map((f) => ({ '@type': 'Question', name: f.pregunta, acceptedAnswer: { '@type': 'Answer', text: f.respuesta } })) }] : [];
const zona = (ciudades as Record<string, any>)[data.slug] || null;
const principal = (principales as Record<string, any>)[data.slug] || null;
const legal = /^(aviso-legal|politica-de-)/.test(data.slug);
const subtitulo = legal ? '' : anadido?.subtitulo ? anadido.subtitulo : zona
  ? `Contenedores para escombros y residuos de obra en ${zona.nombre}: tamaños, precios orientativos y presupuesto sin compromiso.`
  : site.descripcion;
---
<Base
  title={cambios.titulos[key] || seo.titulo || data.title}
  description={cambios.descripciones[key] || seo.descripcion}
  canonical={data.url}
  imagen={principal?.src || seo.imagen}
  ogTitulo={seo.ogTitulo}
  ogDescripcion={seo.ogDescripcion}
  migas={migas}
  datos={datos}
>
  <Hero titulo={tituloH1} subtitulo={subtitulo} cta={!legal} imagen={principal} />
  {anadido && <Anadido datos={anadido} />}
  <Contenido bloques={bloques} filas={filas} omitir={omitir} preguntas={cambios.preguntas} tituloFaq={cambios.tituloFaq} faqExtra={faqBloque ? faq : []} />
  <Zona zona={zona} excavacion={(datosExcavacion as Record<string, any>)[data.slug] ? rutaExcavacion(data.slug) : null} />
  {!faqBloque && <Faq items={faq} />}
</Base>
