---
// Páginas de contenedores de escombros de los lugares nuevos: /contenedores-escombros-<lugar>/
// (Yama, 2026-11-04). Contenido en src/lib/lugares.mjs; las de WordPress van por [...slug].astro.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Anadido from '../components/Anadido.astro';
import Zona from '../components/Zona.astro';
import site from '../data/site.json';
import ciudades from '../data/ciudades.json';
import lugares from '../data/lugares-nuevos.json';
import principales from '../data/principales.json';
import { paginasContenedores } from '../lib/lugares.mjs';
import { rutaExcavacion } from '../lib/excavaciones.mjs';

export function getStaticPaths() {
  return paginasContenedores(lugares, ciudades).map((p: any) => ({ params: { pueblo: p.slug.replace(/^contenedores-escombros-/, '') }, props: { p } }));
}

const { p } = Astro.props as { p: any };
const dominio = `https://${site.dominio}`;
const url = `${dominio}${p.ruta}`;
const principal = (principales as Record<string, any>)[p.slug] || null;
const migas = [{ nombre: 'Inicio', url: `${dominio}/` }, { nombre: p.clave, url }];
const datos = [{ '@type': 'FAQPage', mainEntity: p.faq.map((f: any) => ({ '@type': 'Question', name: f.pregunta, acceptedAnswer: { '@type': 'Answer', text: f.respuesta } })) }];
---
<Base title={p.titulo} description={p.descripcion} canonical={url} imagen={principal?.src} migas={migas} datos={datos}>
  <Hero titulo={p.h1} subtitulo={p.contenido.subtitulo} imagen={principal} />
  <Anadido datos={p.contenido} />
  <Zona zona={(ciudades as Record<string, any>)[p.slug]} excavacion={rutaExcavacion(p.slug)} />
</Base>
