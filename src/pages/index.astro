---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Contenido from '../components/Contenido.astro';
import Faq from '../components/Faq.astro';
import { seoDe } from '../lib/seo';
import data from '../content/pages/index.json';
import faqData from '../data/faq.json';
import site from '../data/site.json';
import ciudades from '../data/ciudades.json';
import cambiosData from '../data/fallos-original.json';
import principales from '../data/principales.json';
import { aplicarCambios, tipoFrase, nombresPropios, detectarFaq } from '../lib/textos.mjs';

// Cambios aprobados por Yama (títulos, H1, descripciones, mayúsculas y alt): src/data/fallos-original.json
const cambios = cambiosData as any;
const propios = nombresPropios(ciudades);
const seo = seoDe('index');
const h1 = data.blocks.find((b: any) => b.type === 'heading' && b.tag === 'h1');
const tituloH1 = cambios.h1['index'] || tipoFrase(h1 ? h1.text : data.title, propios);
const bloques = aplicarCambios(data.blocks, { titulo: tituloH1, propios });
const omitir = data.blocks.map((b: any, i: number) => (b.type === 'heading' && b.tag === 'h1' ? i : -1)).filter((i: number) => i >= 0);
const faq = (faqData as Record<string, any[]>)['index'] || [];
const filas = (data as any).filas || [];
const faqBloque = filas.map((f: any) => detectarFaq(f, bloques, cambios.preguntas)).find(Boolean);
const preguntasPagina = [
  ...(faqBloque ? faqBloque.items.map((it: any) => ({ pregunta: it.q, respuesta: bloques[it.t].text })) : []),
  ...faq,
];
const datos = preguntasPagina.length ? [{ '@type': 'FAQPage', mainEntity: preguntasPagina.map((f) => ({ '@type': 'Question', name: f.pregunta, acceptedAnswer: { '@type': 'Answer', text: f.respuesta } })) }] : [];
---
<Base
  title={cambios.titulos['index'] || seo.titulo || data.title}
  description={cambios.descripciones['index'] || seo.descripcion}
  canonical={data.url}
  imagen={(principales as any).index?.src || seo.imagen}
  ogTitulo={seo.ogTitulo}
  ogDescripcion={seo.ogDescripcion}
  datos={datos}
>
  <Hero titulo={tituloH1} subtitulo={site.descripcion} imagen={(principales as any).index || null} />
  <Contenido bloques={bloques} filas={filas} omitir={omitir} preguntas={cambios.preguntas} tituloFaq={cambios.tituloFaq} faqExtra={faqBloque ? faq : []} />
  {!faqBloque && <Faq items={faq} />}
</Base>
